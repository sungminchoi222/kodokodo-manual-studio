# MANUAL STUDIO 환경변수 예시. 실제 값은 .env.local 에만 넣고 커밋하지 않는다.
# Vercel Marketplace 의 Supabase 연동을 쓰면 아래 값이 Vercel 프로젝트에 자동 등록되며,
# 로컬로는 `npx vercel env pull .env.local` 로 받아올 수 있다.

# --- 브라우저/서버 공용 (공개 가능) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon key 또는 publishable key 중 하나
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 서버 전용 (절대 NEXT_PUBLIC_ 접두사 금지) ---
# service_role key 또는 secret key 중 하나. 시드/관리 스크립트와 서버 측 export job 에서만 사용.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# 마이그레이션 실행용 직접 연결 (pooler 가 아닌 direct/session 연결 권장)
POSTGRES_URL_NON_POOLING=

# 데모 계정 공통 비밀번호 (npm run db:seed 가 이 값으로 데모 계정을 만든다)
DEMO_USER_PASSWORD=
# true 면 로그인 화면에 데모 계정 목록 표시 (운영에서는 끄기)
DEMO_MODE=false

# QR/딥링크에 인쇄할 앱의 안정 주소 (만료되는 storage signed URL 금지)
NEXT_PUBLIC_APP_URL=http://localhost:3000
